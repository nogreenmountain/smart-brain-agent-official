ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The personal key is authenticated by the trusted Windows SmartBrain relay.
# The relay replaces it with its loopback-only CPA key before contacting the
# model service; this image never contains either credential.
ENV SB_PERSONAL_UPSTREAM_AUTH_MODE=smartbrain_relay
COPY --chown=10001:10001 --chmod=0644 agentops_local/api/personal_gateway_proxy.py /app/agentops/api/personal_gateway_proxy.py
