COMPOSE_PROJECT_NAME=smartbrain-current
PUBLIC_HOST=__SET_PUBLIC_HOST_WITH_OPTIONAL_PORT__
PRIVATE_ROOT=/etc/smartbrain-current
STATE_ROOT=/srv/smartbrain-current-state
BACKUP_ROOT=/srv/smartbrain-current-backups
EDGE_PORT=8080
PERSONAL_UPSTREAM_URL=__SET_REACHABLE_CODEX_UPSTREAM_URL__
# Optional relay: only used with --profile relay. Read AI-DEPLOY.md first.
TUNNEL_USER=__SET_TUNNEL_USER__
TUNNEL_HOST=__SET_TUNNEL_HOST__
TUNNEL_PORT=22
TUNNEL_SSH_KEY_PATH=/etc/smartbrain-current/relay/id_ed25519
TUNNEL_KNOWN_HOSTS_PATH=/etc/smartbrain-current/relay/known_hosts
