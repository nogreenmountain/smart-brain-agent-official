# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/models/huggingface
PIP_DISABLE_PIP_VERSION_CHECK=1
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_NO_CACHE_DIR=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
RAG_EMBED_BATCH_SIZE=2
RAG_EMBED_MAX_LENGTH=8192
RAG_EMBED_MODEL_NAME=BAAI/bge-m3
RAG_EMBED_USE_FP16=true
RAG_MODEL_DEVICE=cuda
