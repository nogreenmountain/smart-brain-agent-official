# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/models/huggingface
PIP_DISABLE_PIP_VERSION_CHECK=1
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_NO_CACHE_DIR=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
RAG_MODEL_DEVICE=cuda
RAG_RERANK_BATCH_SIZE=1
RAG_RERANK_MAX_LENGTH=1024
RAG_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RAG_RERANK_USE_FP16=true
