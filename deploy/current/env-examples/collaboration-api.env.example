# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
AI_USAGE_REPORT_MODEL=claude-sonnet-4-6-20250514
AI_WORKLOG_MODEL=claude-sonnet-4-6-20250514
ANTHROPIC_AUTH_TOKEN=__SET_ANTHROPIC_AUTH_TOKEN__
ANTHROPIC_BASE_URL=http://ai-gateway:3000
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8-20250514
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6-20250514
AUTH_COOKIE_SECRET=__SET_AUTH_COOKIE_SECRET__
CACHE_NAMESPACE=smartbrain-production
CACHE_SOCKET_TIMEOUT_SECONDS=3
CLICKHOUSE_DATABASE=otel_2
CLICKHOUSE_PASSWORD=__SET_CLICKHOUSE_PASSWORD__
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=default
FASTEMBED_CACHE_PATH=/var/lib/agentops/tmp/fastembed
HF_HOME=/var/lib/agentops/tmp/huggingface
INGEST_QUEUE_ENABLED=true
JWT_SECRET_KEY=__SET_JWT_SECRET_KEY__
LOGGING_LEVEL=INFO
MATERIAL_UPLOAD_STORAGE_DIR=/var/lib/agentops/material-uploads
MEMBER_WIKI_MODEL=claude-sonnet-4-6-20250514
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_LOGS_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
PROJECT_MATERIAL_ASYNC_PARSE_ENABLED=true
PROJECT_MATERIAL_PARSE_MAX_ATTEMPTS=3
PROJECT_MATERIAL_PARSE_TIMEOUT_SECONDS=900
PROJECT_MEMORY_MODEL=claude-sonnet-4-6-20250514
PROJECT_WIKI_MODEL=claude-sonnet-4-6-20250514
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
RAG_LLM_MODEL=claude-sonnet-4-6-20250514
RAG_RETRIEVAL_VERSION=v2-hybrid
RAG_V2_EMBEDDING_MODEL=BAAI/bge-m3
RAG_V2_EMBEDDING_VERSION=2026-07-21-bge-m3
RAG_V2_EMBED_ON_UPLOAD=false
RAG_V2_FALLBACK_TO_V1=true
RAG_V3_CONTEXTUAL_CHUNKS_ENABLED=false
RAG_V3_ENABLED=false
RAG_V3_GRAPH_ENABLED=false
RAG_V3_QUERY_PLANNER_ENABLED=false
RAG_V3_SELECTIVE_RERANK_ENABLED=false
RAG_V3_SPARSE_ENABLED=false
REQUIRE_SHARED_CACHE=true
SB_GATEWAY_ALLOWED_USER_IDS=__SET_SB_GATEWAY_ALLOWED_USER_IDS__
SB_GATEWAY_LEGACY_EVENTS_ENABLED=false
SB_GATEWAY_TRUSTED_INSTANCES=__SET_SB_GATEWAY_TRUSTED_INSTANCES__
SQLALCHEMY_LOG_LEVEL=WARNING
SUPABASE_AUTH_TIMEOUT_SECONDS=15
SUPABASE_DATABASE=postgres
SUPABASE_JWT_SECRET=__SET_SUPABASE_JWT_SECRET__
SUPABASE_KEY=__SET_SUPABASE_KEY__
SUPABASE_MAX_POOL_SIZE=4
SUPABASE_MIN_POOL_SIZE=1
SUPABASE_PASSWORD=__SET_SUPABASE_PASSWORD__
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_BUCKET=
SUPABASE_S3_LOGS_BUCKET=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_SSLMODE=disable
SUPABASE_USER=postgres
TIKTOKEN_CACHE_DIR=/app/tiktoken-cache
TMPDIR=/var/lib/agentops/tmp
WIKI_MCP_TOKEN_SECRET=__SET_WIKI_MCP_TOKEN_SECRET__
WORKDAY_COLLECTOR_ENDPOINT=__SET_WORKDAY_COLLECTOR_ENDPOINT__
WORKDAY_ENROLLMENT_TOKEN_DAYS=30
XDG_CACHE_HOME=/var/lib/agentops/tmp/.cache
