# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
PGRST_ADMIN_SERVER_HOST=127.0.0.1
PGRST_ADMIN_SERVER_PORT=3001
PGRST_APP_SETTINGS_JWT_EXP=3600
PGRST_APP_SETTINGS_JWT_SECRET=__SET_PGRST_APP_SETTINGS_JWT_SECRET__
PGRST_DB_ANON_ROLE=anon
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000
PGRST_DB_SCHEMAS=public
PGRST_DB_URI=__SET_PGRST_DB_URI__
PGRST_DB_USE_LEGACY_GUCS=false
PGRST_JWT_SECRET=__SET_PGRST_JWT_SECRET__
