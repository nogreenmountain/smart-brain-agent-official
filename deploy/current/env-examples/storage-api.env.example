# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
ANON_KEY=__SET_ANON_KEY__
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_SECRET=__SET_AUTH_JWT_SECRET__
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL=__SET_DATABASE_URL__
DB_INSTALL_ROLES=false
ENABLE_IMAGE_TRANSFORMATION=false
FILE_SIZE_LIMIT=524288000
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
GLOBAL_S3_BUCKET=
GLOBAL_S3_ENDPOINT=
GLOBAL_S3_FORCE_PATH_STYLE=false
GLOBAL_S3_PROTOCOL=https
IMAGE_TRANSFORMATION_ENABLED=false
POSTGREST_URL=http://postgrest:3000
REGION=local
REQUEST_ALLOW_X_FORWARDED_PATH=true
SERVER_PORT=5000
SERVICE_KEY=__SET_SERVICE_KEY__
STORAGE_BACKEND=file
STORAGE_FILE_BACKEND_PATH=/var/lib/storage
STORAGE_PUBLIC_URL=__SET_STORAGE_PUBLIC_URL__
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PRIVATE_ASSET_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_TENANT_ID=smartbrain
TENANT_ID=smartbrain
UPLOAD_FILE_SIZE_LIMIT=524288000
UPLOAD_FILE_SIZE_LIMIT_STANDARD=524288000
UPLOAD_SIGNED_URL_EXPIRATION_TIME=120
VERSION=1.60.4
XDG_CACHE_HOME=/tmp/.cache
