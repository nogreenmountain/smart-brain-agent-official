# Private runtime values: copy outside checkout; raw env_file, no shell expansion.
CLICKHOUSE_DATABASE=otel_2
CLICKHOUSE_ENDPOINT=http://clickhouse:8123
CLICKHOUSE_PASSWORD=__SET_CLICKHOUSE_PASSWORD__
CLICKHOUSE_TIMEOUT=60s
CLICKHOUSE_TTL=720h
CLICKHOUSE_USERNAME=default
JWT_SECRET=__SET_JWT_SECRET__
LOGS_TABLE_NAME=otel_logs
TRACES_TABLE_NAME=otel_traces
