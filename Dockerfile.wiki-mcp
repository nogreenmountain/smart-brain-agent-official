# Preserve the actual MCP runtime and existing material/auth capabilities.
# Recheck the active image before release; do not use the older API parent.
ARG BASE_IMAGE=smartbrain/wiki-mcp@sha256:f082527c40bb30d645072afeafcf8c76bf61b6589cdf6ca46017d14c09f0a1b4
FROM ${BASE_IMAGE}

COPY agentops_local/wiki_mcp/server.py agentops_local/wiki_mcp/operations.py agentops_local/wiki_mcp/materials.py /app/agentops/wiki_mcp/
COPY agentops_local/project_memory/conversations.py /app/agentops/project_memory/conversations.py

EXPOSE 8010

CMD ["/app/.venv/bin/python", "-m", "agentops.wiki_mcp.server"]
